# BetterAgentX .gitignore

# Node modules
node_modules/
package-lock.json
yarn.lock

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Archivos temporales
tmp/
temp/
.cache/
*.backup
*.bak
*.tmp

# Archivos de prueba
test-output/
coverage/
.nyc_output/

# Distribución
dist/
build/

# Documentación archivada (no esencial para funcionamiento)
docs-archive/

# BetterAgents - Claude Code Edition
# Memory files (local, private — not tracked in repo)
.claude/memory/*.json
!.claude/memory/MEMORY.md
.claude/memory/session-last.md
.claude/memory/.session-*-tmp

# Local runtime config (machine-specific, not tracked)
.claude/settings.json
.claude/.betteragents-mode

# Cache and backups (auto-generated)
.claude/cache/
.claude/backups/
.claude/.version

# Skills (installed locally, not tracked)
.claude/skills/
